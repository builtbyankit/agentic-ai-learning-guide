{
  "dataset_version": "agentic-rag-advanced-holdout-v1",
  "split": "holdout",
  "top_k": 5,
  "min_score": 0.22,
  "lexical_relative_score_floor": 0.3,
  "allowed_classifications": [
    "public",
    "internal"
  ],
  "scenarios": [
    {
      "id": "holdout-arrival-dented",
      "query": "A box arrived damaged. By when should I report it?",
      "expected_source_ids": [
        "damage-policy"
      ]
    },
    {
      "id": "holdout-return-sealed-item",
      "query": "What is the current window for returning sealed merchandise?",
      "expected_source_ids": [
        "returns-policy"
      ],
      "expected_versions": {
        "returns-policy": "2026.2"
      }
    },
    {
      "id": "holdout-legacy-window",
      "query": "Does the old sixty-day return rule still apply?",
      "expected_source_ids": [
        "returns-policy"
      ],
      "expected_versions": {
        "returns-policy": "2026.2"
      }
    },
    {
      "id": "holdout-credit-not-posted",
      "query": "My bank has not posted an approved reimbursement.",
      "expected_source_ids": [
        "refund-processing"
      ]
    },
    {
      "id": "holdout-delivery-guarantee",
      "query": "Can the carrier arrival estimate be relied on as a promise?",
      "expected_source_ids": [
        "shipping-policy"
      ]
    },
    {
      "id": "holdout-stale-carrier-status",
